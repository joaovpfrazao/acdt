(export (version "E")
  (design (source "UAV ISR — caso sobre-restringido (demonstração de inviabilidade)") (date "") (tool "acdt harness"))
  (components
    (comp (ref "BAT") (value "XT90-class") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "Connector_Generic") (part "Conn_01x02") (description "acdt harness connector")))
    (comp (ref "ESC") (value "CONN") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "Connector_Generic") (part "Conn_01x02") (description "acdt harness connector")))
    (comp (ref "PDB") (value "power distribution board") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x06_P2.54mm_Vertical")
      (libsource (lib "Connector_Generic") (part "Conn_01x06") (description "acdt harness connector")))
    (comp (ref "AP") (value "cubepilot_cube_orange_plus") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "Connector_Generic") (part "Conn_01x02") (description "acdt harness connector")))
    (comp (ref "SRV") (value "servo rail") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical")
      (libsource (lib "Connector_Generic") (part "Conn_01x02") (description "acdt harness connector")))
  )
  (nets
    (net (code "1") (name "/VBAT")
      (node (ref "BAT") (pin "1") (pinfunction "+"))
      (node (ref "ESC") (pin "1") (pinfunction "+")))
    (net (code "2") (name "/GND")
      (node (ref "BAT") (pin "2") (pinfunction "-"))
      (node (ref "ESC") (pin "2") (pinfunction "-")))
    (net (code "3") (name "/5V_AV")
      (node (ref "PDB") (pin "3") (pinfunction "5V"))
      (node (ref "AP") (pin "1") (pinfunction "5V")))
    (net (code "4") (name "/GND_AV")
      (node (ref "PDB") (pin "4") (pinfunction "GND"))
      (node (ref "AP") (pin "2") (pinfunction "GND")))
    (net (code "5") (name "/VSERVO")
      (node (ref "PDB") (pin "5") (pinfunction "SERVO+"))
      (node (ref "SRV") (pin "1") (pinfunction "+")))
    (net (code "6") (name "/GND_SRV")
      (node (ref "PDB") (pin "6") (pinfunction "SERVO-"))
      (node (ref "SRV") (pin "2") (pinfunction "-")))
  )
)
