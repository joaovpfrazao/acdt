graph "UAV ISR elétrico 25 kg power harness" {
  rankdir=LR; node [shape=record];
  "BAT" [label="BAT|{<+> +|<-> -}"];
  "ESC" [label="ESC|{<+> +|<-> -}"];
  "PDB" [label="PDB|{<+> +|<-> -|<5V> 5V|<GND> GND|<SERVO+> SERVO+|<SERVO-> SERVO-}"];
  "AP" [label="AP|{<5V> 5V|<GND> GND}"];
  "SRV" [label="SRV|{<+> +|<-> -}"];
  "BAT":"+" -- "ESC":"+" [label="W1 VBAT 6AWG"];
  "BAT":"-" -- "ESC":"-" [label="W2 GND 6AWG"];
  "PDB":"5V" -- "AP":"5V" [label="W3 5V_AV 22AWG"];
  "PDB":"GND" -- "AP":"GND" [label="W4 GND_AV 22AWG"];
  "PDB":"SERVO+" -- "SRV":"+" [label="W5 VSERVO 12AWG"];
  "PDB":"SERVO-" -- "SRV":"-" [label="W6 GND_SRV 12AWG"];
}